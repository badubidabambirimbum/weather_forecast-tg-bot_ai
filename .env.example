# PostgreSQL (docker compose up -d postgres). Пароль не коммитить в реальном .env.
POSTGRES_USER=weather
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=weather
POSTGRES_PORT=5432
# Async URL для SQLAlchemy (backend, Alembic). localhost — доступ с хоста к контейнеру.
DATABASE_URL=postgresql+asyncpg://weather:replace_with_strong_password@localhost:5432/weather

BOT_TOKEN=your_telegram_bot_token
# Секрет подписи cookie сессии (длинная случайная строка; не коммитить реальное значение).
SESSION_SECRET=replace_with_long_random_string
# Публичная ссылка на бота для экрана «откройте из Telegram» (например https://t.me/your_bot).
BOT_URL=https://t.me/your_bot
# Для HTTPS (ngrok/production): COOKIE_SECURE=1 чтобы браузер принимал cookie с флагом Secure.
# COOKIE_SECURE=1
# Для Telegram Web (iframe) часто нужен SameSite=None (требует Secure).
# COOKIE_SAMESITE=none
MINIAPP_URL=https://your-public-miniapp-url
